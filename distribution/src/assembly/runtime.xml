<?xml version="1.0" ?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0">
  <id>runtime</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>true</includeBaseDirectory>
  <fileSets>
    <fileSet>
      <directory>../licenses</directory>
      <outputDirectory>licenses</outputDirectory>
    </fileSet>
    <fileSet>
      <directory>../scripts</directory>
      <outputDirectory>scripts</outputDirectory>
      <fileMode>0755</fileMode>
    </fileSet>
    <fileSet>
      <directory>../config</directory>
      <outputDirectory>config</outputDirectory>
      <excludes>
        <exclude>*.local.properties</exclude>
        <exclude>*.p12</exclude>
        <exclude>users.properties</exclude>
      </excludes>
    </fileSet>
    <fileSet>
      <directory>../docs</directory>
      <outputDirectory>docs</outputDirectory>
    </fileSet>
  </fileSets>
  <dependencySets>
    <dependencySet>
      <outputDirectory>licenses/${artifact.groupId}-${artifact.artifactId}-${artifact.version}</outputDirectory>
      <useProjectArtifact>false</useProjectArtifact>
      <excludes>
        <exclude>de.jumpstart:*</exclude>
      </excludes>
      <unpack>true</unpack>
      <unpackOptions>
        <includes>
          <include>META-INF/LICENSE*</include>
          <include>META-INF/NOTICE*</include>
          <include>META-INF/DEPENDENCIES*</include>
          <include>**/license*</include>
          <include>**/COPYING*</include>
        </includes>
      </unpackOptions>
    </dependencySet>
  </dependencySets>
  <files>
    <file>
      <source>../RUN.md</source>
      <outputDirectory>/</outputDirectory>
    </file>
    <file>
      <source>../broker/target/broker.jar</source>
      <outputDirectory>lib</outputDirectory>
    </file>
    <file>
      <source>../lab/target/lab.jar</source>
      <outputDirectory>lib</outputDirectory>
    </file>
    <file>
      <source>../README.md</source>
      <outputDirectory>/</outputDirectory>
    </file>
    <file>
      <source>../LICENSE</source>
      <outputDirectory>/</outputDirectory>
    </file>
    <file>
      <source>../NOTICE</source>
      <outputDirectory>/</outputDirectory>
    </file>
  </files>
</assembly>
