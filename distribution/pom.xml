<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>de.jumpstart</groupId>
    <artifactId>artemis-java-jumpstart</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>distribution</artifactId>
  <dependencies>
    <dependency>
      <groupId>de.jumpstart</groupId>
      <artifactId>broker</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>de.jumpstart</groupId>
      <artifactId>lab</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <training.enabled>${training.enabled}</training.enabled>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <descriptors>
            <descriptor>src/assembly/runtime.xml</descriptor>
          </descriptors>
          <finalName>artemis-java-jumpstart</finalName>
        </configuration>
        <executions>
          <execution>
            <id>runtime</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>training</id>
      <dependencies>
        <dependency>
          <groupId>de.jumpstart</groupId>
          <artifactId>solutions</artifactId>
          <version>${project.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>de.jumpstart</groupId>
          <artifactId>exercises</artifactId>
          <version>${project.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
